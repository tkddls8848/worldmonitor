# Single-owner setup. Copy to .env.local; never commit credentials.
# Node 24. Start: npm run build:personal && npm run start:personal
# Collect: npm run collect:personal -- --watch 15
# No hosted deployment, accounts, relay URL, or relay shared secret is required.
WM_PERSONAL_HOST=127.0.0.1
WM_PERSONAL_PORT=3000
WM_PERSONAL_STORE=embedded
WM_PERSONAL_STORE_FILE=.personal/store.ndjson
UPSTASH_REDIS_REST_URL=http://127.0.0.1:8079
# Choose a random token of at least 16 characters, shared with local collectors.
UPSTASH_REDIS_REST_TOKEN=

# Optional data-source / AI credentials. Configure only sources you use.
# AIS uses AISSTREAM_API_KEY; sirens use the free Tzeva Adom feed by default.
ABUSEIPDB_API_KEY=
ACLED_ACCESS_TOKEN=
ACLED_EMAIL=
ACLED_PASSWORD=
AISSTREAM_API_KEY=
ALPHA_VANTAGE_API_KEY=
ANTHROPIC_API_KEY=
COINGECKO_API_KEY=
COINGECKO_DEMO_API_KEY=
CONSUMER_PRICES_CORE_API_KEY=
DTM_API_KEY=
EARTHDATA_TOKEN=
ECOS_API_KEY=
EIA_API_KEY=
FINNHUB_API_KEY=
FIRECRAWL_API_KEY=
FRED_API_KEY=
GIE_API_KEY=
GOOGLE_FACT_CHECK_API_KEY=
ICAO_API_KEY=
IMF_API_KEY=
JAPAN_MOD_PROXY_URL=
LLM_API_KEY=
NASA_FIRMS_API_KEY=
NVD_API_KEY=
OLLAMA_API_KEY=
OLLAMA_API_URL=
OLLAMA_MODEL=
OPENDART_API_KEY=
OPENROUTER_API_KEY=
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
OREF_PROXY_AUTH=
OTX_API_KEY=
PROXY_URL=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
SAM_GOV_API_KEY=
SCRAPECREATORS_API_KEY=
TRAVELPAYOUTS_API_TOKEN=
TYPESAFE_API_KEY=
UCDP_ACCESS_TOKEN=
USDA_FAS_PSD_API_KEY=
WINDY_API_KEY=
WINGBITS_API_KEY=
WTO_API_KEY=

# Optional local history database; the default is .personal/intel-history.sqlite.
WM_INTEL_HISTORY_DB=
# Exact Host values only, if you use your own access-controlled HTTPS proxy.
WM_PERSONAL_ALLOWED_HOSTS=
